.vscode/
node_modules/
src/
server/src/
server/*.json
test/
views/test/

patch_app/
patch_gen_gui/
	# どちらも拡張機能には組み込まない独立ツール（開発者が手元で実行する。
	# src/docs/legacy-app-patch.md参照）。Rustのビルド成果物（target/。
	# patch_gen_guiはcargo tauri devのdebugビルドで6GB規模）を含め
	# VSIXに混入させないこと

**/*.cs
**/*.d.ts
**/*.map
**/*.ts
**/*.mts
	# views/vite.config.mts（**/*.ts には一致しない）
**/*.vue

views/setting.html
dist/assets/setting.html
	# 実行時に読むのは vite が出力した dist/setting.html だけ（src/PrjSetting.ts）。
	# views/setting.html はその入力。dist/assets/setting.html は入力の
	# <link rel="canonical" href="setting.html"> を vite がアセットと見なして
	# 複製したもので、どこからも読まれない

views/score.*
	# CteScore（SKYNovel.score）凍結中（2026-10-22）。score.ts/score.htm は
	# 配線を外したので到達不能。score.ts.frozen は **/*.ts に一致しないため明示

.claude/
CLAUDE.md
.gitignore
eslint.config.mts
tools/
tsconfig*.json
.vscode-test*
	# 統合テスト実行時の VSCode ユーザーデータ

**/bun.lock
**/*.tsbuildinfo
**/eslint.config.*
	# 同梱する server/node_modules/ の中にも入っているので ** で
